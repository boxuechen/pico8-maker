pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- ============================================================
--  EMBERWARDEN  --  arena boss duel, three phases
--  Move: arrows / wasd       Dash: O or Z (brief invulnerability)
--  WHITE telegraph = attack is coming
--  RED = live attack            PALE CORE = opening / counter window
--  Dash into the core during an opening to land one counter hit.
-- ============================================================

local ARENAR=52
local CX,CY=64,64

px=64 py=88 pvx=0 pvy=0 pdirx=0 pdiry=-1
pstate="idle" dframes=0 pcool=0
brx=64 bry=32 brvx=0.4 brvy=0.3
hp=10 maxhp=10 phase=1
atk=nil teleg=0 act=0 cd=45
opentimer=0
sweepleft=0 sweepan=0 rainleft=0
shards={} spikes={} pop={}
hurtflash=0 shake=0 ringpulse=0
best=0 gtime=0 ftimer=0 msg=nil msgT=0 titleT=0
state="title"

-- ---------- audio ----------
function cpol(k,w,v,e) return {k,w%4+8*flr(w/4),v,e} end
function write_sfx(id,notes,speed)
 local base=0x3200+id*68
 memset(base,0,68)
 for i=1,#notes do
  local n=notes[i]
  poke(base+(i-1)*2,n[1]+(n[2]%4)*64)
  poke(base+(i-1)*2+1,flr(n[2]/4)+n[3]*2+n[4]*16)
 end
 poke(base+65,speed)
end
function init_audio()
 write_sfx(0,{cpol(38,1,3,1),cpol(34,1,3,1),cpol(28,1,2,1),cpol(22,1,1,1)},5)
 write_sfx(1,{cpol(36,3,5,0),cpol(43,3,5,0),cpol(48,3,4,0),cpol(55,3,3,2)},5)
 write_sfx(2,{cpol(30,6,5,3),cpol(22,6,4,3),cpol(14,6,3,3)},7)
 write_sfx(3,{cpol(34,6,6,3),cpol(26,6,6,3),cpol(18,6,5,3),cpol(13,6,4,3),cpol(8,6,3,3),cpol(5,6,2,3)},10)
 write_sfx(4,{cpol(36,0,4,0),cpol(43,0,4,0),cpol(48,0,3,0)},6)
 write_sfx(5,{cpol(24,2,3,2),cpol(28,2,4,2),cpol(33,2,5,2)},8)
 write_sfx(6,{cpol(46,4,2,3),cpol(38,4,2,3)},4)
 write_sfx(7,{cpol(36,0,5,0),cpol(43,0,5,0),cpol(48,0,5,0),cpol(55,0,5,0),cpol(60,0,4,2)},7)
 write_sfx(8,{cpol(16,1,3,1),cpol(22,1,3,1),cpol(16,1,2,1)},7)
 local m,m2,a,a2={},{},{},{}
 local ch1={24,27,31,36,31,27}
 local ch2={26,29,33,38,33,29}
 local ar1={48,55,60,55,48,55,63,60}
 local ar2={50,57,62,57,53,62,66,62}
 for i=1,32 do
  add(m,cpol(ch1[1+flr((i-1)/4)%#ch1],5,3,0))
  add(m2,cpol(ch2[1+flr((i-1)/4)%#ch2],5,3,0))
  add(a,cpol(ar1[1+(i-1)%8],0,2,0))
  add(a2,cpol(ar2[1+(i-1)%8],0,2,0))
 end
 write_sfx(20,m,10) write_sfx(22,m2,10)
 write_sfx(21,a,6)  write_sfx(23,a2,6)
 local function pat(id,c0,c1)
  local b=0x3100+id*4
  poke(b,c0) poke(b+1,c1) poke(b+2,64) poke(b+3,64)
 end
 pat(0,20,21) pat(1,22,23)
end

-- ---------- init ----------
function _init()
 cartdata("emberwarden_v1")
 best=flr(dget(1) or 0)
 if best<0 or best>9999 then best=0 end
 srand(7)
 init_audio()
 state="title"
 gtime=0 titleT=0 ftimer=0
 music(0,0,3)
end

function clear_field()
 shards={} spikes={} pop={}
 atk=nil teleg=0 act=0 opentimer=0
 sweepleft=0 rainleft=0
end

function start_round()
 phase=1 hp=maxhp
 px,py=64,88 pvx,pvy=0,0 pdirx,pdiry=0,-1
 pstate="idle" dframes=0 pcool=0
 brx,bry=64,32 brvx=0.4 brvy=0.3
 clear_field()
 hurtflash=0 shake=0 ringpulse=0
 cd=50 gtime=0
 msg="PHASE 1" msgT=80
 music(0,0,3)
 state="play"
end

-- ---------- boss ----------
function atkname(a)
 if a=="ring" then return "SHARD NOVA" end
 if a=="spike" then return "SPIKE BLOOM" end
 if a=="spiral" then return "SPIRAL SWEEP" end
 if a=="rain" then return "SHARD RAIN" end
 return a
end

function choose_attack()
 cd=math.max(26,52-phase*8)
 local pool
 if phase==1 then pool={"ring","spike"}
 elseif phase==2 then pool={"ring","spike","spiral","rain"}
 else pool={"spiral","rain","ring","spike"} end
 atk=pool[1+flr(rnd(#pool))]
 teleg=math.max(26,48-phase*5)
 act=0
 sfx(5,2,0,3)
 msg=atkname(atk) msgT=teleg-2
end

function fire_attack()
 sfx(8,2,0,3)
 if atk=="ring" then
  local n=8+phase*2
  local spd=1.0+phase*0.22
  for i=1,n do
   local an=(i/n)+rnd(0.12)
   add(shards,{x=brx,y=bry,vx=cos(an)*spd,vy=sin(an)*spd,t=0,col=8})
  end
  act=12
 elseif atk=="spike" then
  local n=2+phase
  for i=1,n do
   add(spikes,{ang=rnd(1),dist=ARENAR-3,warn=0,warnmax=30,life=22,amm=22})
  end
  act=8
 elseif atk=="spiral" then
  sweepleft=12+phase*3 sweepan=rnd(1)
  act=0
 elseif atk=="rain" then
  rainleft=6+phase*3
  act=0
 end
end

function open_boss()
 atk=nil
 opentimer=70-phase*6
 cd=math.max(30,56-phase*8)
 msg="OPENING!" msgT=45
 ringpulse=1
 sfx(4,2,0,3)
end

function update_boss()
 brx+=brvx bry+=brvy
 if brx<46 then brx=46 brvx=-brvx end
 if brx>82 then brx=82 brvx=-brvx end
 if bry<26 then bry=26 brvy=-brvy end
 if bry>44 then bry=44 brvy=-brvy end

 if atk==nil then
  cd-=1
  if cd<=0 and opentimer<=0 then choose_attack() end
  return
 end
 if teleg>0 then
  teleg-=1
  if teleg==0 then fire_attack() end
  return
 end
 if act>0 then
  act-=1
  return
 end
 if atk=="spiral" and sweepleft>0 then
  add(shards,{x=brx,y=bry,vx=cos(sweepan)*1.6,vy=sin(sweepan)*1.6,t=0,col=8})
  sweepan+=0.10
  sweepleft-=1
  if sweepleft<=0 then open_boss() end
  return
 end
 if atk=="rain" and rainleft>0 then
  if gtime%4==0 then
   add(shards,{x=rnd(128),y=-4,vx=0,vy=1.5+phase*0.22,t=0,col=8})
   sfx(6,2,0,2)
   rainleft-=1
  end
  if rainleft<=0 then open_boss() end
  return
 end
 if atk=="ring" or atk=="spike" then
  if act==0 then open_boss() end
 end
end

-- ---------- field ----------
function update_spikes()
 for s in all(spikes) do
  if s.amm>0 then s.amm-=1 end
  s.life-=1
  if s.life<=0 then del(spikes,s) end
 end
end

function update_shards()
 for s in all(shards) do
  s.x+=s.vx s.y+=s.vy s.t+=1
  if s.x<-6 or s.x>134 or s.y<-6 or s.y>134 or s.t>400 then del(shards,s) end
 end
end

function spawn_pop(x,y,n,c)
 for i=1,n do
  local an=rnd(1)
  local s=rnd(1.6)+0.4
  add(pop,{x=x,y=y,vx=cos(an)*s,vy=sin(an)*s,t=14,c=c or 9})
 end
end
function update_particles()
 for p in all(pop) do
  p.x+=p.vx p.y+=p.vy p.vx*=0.9 p.vy*=0.9 p.t-=1
  if p.t<=0 then del(pop,p) end
 end
end

-- ---------- damage ----------
function hurt_player()
 if pstate=="dashing" then return end
 if hurtflash>0 then return end
 hp-=1
 hurtflash=45
 shake=3
 sfx(2,3,0,3)
 spawn_pop(px,py,8,8)
 if hp<=0 then
  state="dead"
  ftimer=0
 end
end

function counter_hit()
 hp-=1
 sfx(1,3,0,4)
 spawn_pop(brx,bry,16,10)
 shake=4
 clear_field()
 msg="COUNTER!" msgT=30
 cd=40
 if hp<=0 then
  state="win" ftimer=0
  clear_field()
  sfx(3,2,0,4)
  sfx(7,3,0,5)
  local score=math.max(0,9000-gtime*3)
  if score>best then best=score dset(1,best) end
 else
  local ph=1
  if hp<=4 then ph=3 elseif hp<=7 then ph=2 end
  if ph>phase then
   phase=ph
   msg="PHASE "..phase msgT=80
   sfx(5,2,0,3)
   ringpulse=1 shake=4
   cd=55
   opentimer=0
  end
 end
end

-- ============================================================
function _update60()
 gtime+=1
 if state=="title" then titleT+=1 end

 if state=="title" then
  update_particles()
  if btnp(4) or btnp(5) then sfx(4,3,0,3) start_round() end
  return
 elseif state=="dead" then
  ftimer+=1 update_particles()
  if (btnp(4) or btnp(5)) and ftimer>15 then sfx(4,3,0,3) start_round() end
  return
 elseif state=="win" then
  ftimer+=1 update_particles()
  if ftimer%5==0 and ftimer<80 then spawn_pop(brx+rnd(10)-5,bry+rnd(10)-5,4,9) end
  if (btnp(4) or btnp(5)) and ftimer>40 then sfx(4,3,0,3) start_round() end
  return
 end

 if msgT>0 then msgT-=1 end
 if hurtflash>0 then hurtflash-=1 end
 if shake>0 then shake=math.max(0,shake-0.3) end
 if ringpulse>0 then ringpulse=math.max(0,ringpulse-0.02) end
 if opentimer>0 then opentimer-=1 end
 if pcool>0 then pcool-=1 end

 local ax,ay=0,0
 if btn(0) then ax-=1 end
 if btn(1) then ax+=1 end
 if btn(2) then ay-=1 end
 if btn(3) then ay+=1 end
 if ax!=0 and ay!=0 then ax*=0.7071 ay*=0.7071 end
 pvx=ax*1.5 pvy=ay*1.5

 if pstate=="dashing" then
  pvx+=pdirx*3.6 pvy+=pdiry*3.6
  dframes-=1
  if dframes<=0 then pstate="idle" end
 else
  if btnp(4) or btnp(5) then
   local dxp,dyp=ax,ay
   if dxp==0 and dyp==0 then dxp,dyp=0,-1 end
   local l=sqrt(dxp*dxp+dyp*dyp)
   pdirx,pdiry=dxp/l,dyp/l
   pstate="dashing" dframes=10
   sfx(0,3,0,4)
  end
 end

 local nx,ny=px+pvx,py+pvy
 local dx,dy=nx-CX,ny-CY
 local d=sqrt(dx*dx+dy*dy)
 if d>ARENAR then nx=CX+dx/d*ARENAR ny=CY+dy/d*ARENAR end
 px,py=nx,ny
 if pstate=="dashing" and gtime%2==0 then spawn_pop(px,py,1,9) end

 update_boss()
 update_spikes()
 update_shards()
 update_particles()

 if hurtflash<=0 then
  for s in all(shards) do
   local ex,ey=s.x-px,s.y-py
   if ex*ex+ey*ey<25 then hurt_player() break end
  end
 end
 if hurtflash<=0 then
  for s in all(spikes) do
   if s.life<8 then
    local sx=CX+cos(s.ang)*s.dist
    local sy=CY+sin(s.ang)*s.dist
    local ex,ey=sx-px,sy-py
    if ex*ex+ey*ey<36 then hurt_player() break end
   end
  end
 end
 if pstate=="dashing" and opentimer>0 then
  local ex,ey=brx-px,bry-py
  if ex*ex+ey*ey<110 then counter_hit() end
 end
end

-- ============================================================
function _draw()
 cls(1)
 for i=1,5 do
  circ(64,64,i*13,0)
 end

 if state=="title" then draw_title() return end

 draw_arena()
 draw_boss()
 draw_spikes()
 draw_shards()
 draw_player()
 draw_particles()
 draw_hud()

 if state=="dead" then draw_dead() end
 if state=="win" then draw_win() end
end

function draw_arena()
 circfill(64,64,ARENAR+2,0)
 circ(64,64,ARENAR+1,5)
 circ(64,64,ARENAR-6,1)
 for i=0,11 do
  local an=i/12+gtime/900
  pset(64+cos(an)*(ARENAR-3),64+sin(an)*(ARENAR-3),5)
 end
 if opentimer>0 then
  local rr=10+(70-opentimer)*0.6
  circ(brx,bry,rr,7)
 end
end

function draw_boss()
 local t=gtime/30
 if teleg>0 then
  circ(brx,bry,9+(1-teleg/40)*4,7)
  for i=0,7 do
   local an=i/8+gtime/40
   line(brx+cos(an)*9,bry+sin(an)*9,brx+cos(an)*12,bry+sin(an)*12,7)
  end
 end
 local bodyc=11
 if phase==1 then bodyc=11 elseif phase==2 then bodyc=12 else bodyc=8 end
 if atk and teleg==0 then bodyc=8 end
 if hurtflash>0 and hurtflash%6<3 then bodyc=7 end
 for i=1,8 do
  local an=i/8+t*0.3
  local tip=12+(((gtime%30)<15) and 2 or 0)
  line(brx+cos(an)*9,bry+sin(an)*9,brx+cos(an)*tip,bry+sin(an)*tip,bodyc)
 end
 circfill(brx,bry,8,bodyc)
 circfill(brx,bry,6,math.max(0,bodyc-1))
 circfill(brx,bry,4,bodyc)
 if opentimer>0 then
  local glow=7
  if gtime%10<5 then glow=10 end
  circfill(brx,bry,3,glow)
  circ(brx,bry,4,7)
  circ(brx,bry,5,0)
 else
  circfill(brx,bry,2,0)
  pset(brx-1,bry,7) pset(brx+1,bry,7)
 end
end

function draw_spikes()
 for s in all(spikes) do
  local sx=CX+cos(s.ang)*s.dist
  local sy=CY+sin(s.ang)*s.dist
  if s.life>=8 then
   local blink=(gtime%8<4) and 7 or 5
   circ(sx,sy,4,blink)
   circ(sx,sy,2,blink)
   line(sx-2,sy,sx+2,sy,blink)
  else
   local ix=CX+cos(s.ang)*(s.dist-7)
   local iy=CY+sin(s.ang)*(s.dist-7)
   line(sx-2,sy-2,ix,iy,8)
   line(sx+2,sy-2,ix,iy,8)
   line(sx,sy+2,ix,iy,8)
   circfill(sx,sy,2,8)
  end
 end
end

function draw_shards()
 for s in all(shards) do
  line(s.x,s.y,s.x-s.vx*3,s.y-s.vy*3,9)
  circfill(s.x,s.y,1.6,8)
  pset(s.x,s.y,10)
 end
end

function draw_player()
 local c=12
 if pstate=="dashing" then c=7 end
 if hurtflash>0 and hurtflash%6<3 then c=8 end
 if pstate=="dashing" then line(px-pdirx*5,py-pdiry*5,px,py,9) end
 circfill(px,py,3,c)
 circ(px,py,3,7)
 pset(px,py,7)
end

function draw_particles()
 for p in all(pop) do
  pset(p.x,p.y,p.c)
  if p.t>8 then pset(p.x+1,p.y,p.c) end
 end
end

function draw_hud()
 print("HP",3,2,6)
 for i=1,maxhp do
  local x=16+(i-1)*6
  if i<=hp then rectfill(x,3,x+4,6,(i<=4) and 8 or 11)
  else rect(x,3,x+4,6,5) end
 end
 print("PHASE "..phase,102,2,10)
 if best>0 then print("BEST "..best,84,10,5) end
 if msgT>0 and msg then
  local w=#msg*4
  local x=64-w/2
  rectfill(x-3,56,x+w+2,67,0)
  local col=7
  if msg=="OPENING!" or msg:sub(1,5)=="PHASE" then col=10 end
  print(msg,x,59,col)
 end
end

function draw_dead()
 rectfill(0,0,127,127,0)
 print("WARDEN PREVAILS",28,44,8)
 print("reached phase "..phase,44,58,6)
 print("press O / Z to retry",36,74,7)
end

function draw_win()
 rectfill(0,0,127,127,0)
 print("WARDEN FELLED!",36,44,11)
 print("best: "..best,52,60,10)
 print("press O / Z to rematch",22,80,7)
 if ftimer%12<6 then circfill(64,68,2,9) end
end

function draw_title()
 local t=titleT/30
 for i=1,6 do
  local an=i/6+t*0.4
  line(64+cos(an)*8,52+sin(an)*8,64+cos(an)*16,52+sin(an)*16,7)
 end
 circfill(64,52,7,10)
 circfill(64,52,4,9)
 circ(64,52,9,7)
 print("EMBERWARDEN",30,20,10)
 print("arena boss",44,32,6)
 print("arrows/wasd  move",20,74,7)
 print("O or Z  dash",28,86,11)
 print("white = warning",24,98,7)
 print("red = attack",28,108,8)
 if titleT%40<26 then print("press O / Z",42,118,10) end
end

__label__

pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- FERRY CREEK
-- Rescue stranded creatures across a dangerous creek.
-- Timing (safe windows) + carrying capacity create choices.

local SFX_LOAD,SFX_UNLOAD,SFX_PICK,SFX_DROP,SFX_SPLASH,SFX_RESCUE=0,1,2,3,4,5
local SFX_LOSE,SFX_CLEAR,SFX_START,SFX_WARN=6,7,8,9

function write_sfx(id,notes,speed)
 local base=0x3200+id*68
 memset(base,0,68)
 for i,n in ipairs(notes) do
  local k,w,v,e=n[1],n[2],n[3],n[4]
  poke(base+(i-1)*2,k+(w%4)*64)
  poke(base+(i-1)*2+1,flr(w/4)+v*2+e*16)
 end
 poke(base+65,speed)
end

-- procedural sprite art (8x8) -------------------------------------------
local S={
 [1]={"00000000","00000000","00666600","06666660",
      "06666660","00444400","00000000","00000000"}, -- boat empty
 [2]={"00000000","00077700","00666600","06666660",
      "06666660","00444400","00000000","00000000"}, -- boat w/ passenger
 [3]={"00000000","00000000","000bb000","00b7b7b0",
      "0bbb0bbb","0bbbbbb0","00bb0bb0","00000000"}, -- blob green
 [4]={"00000000","00e000e0","00ee0ee0","0ee777ee",
      "0e77777e","0eeeeeee","00eeeee0","00000000"}, -- spiky pink
 [5]={"00000000","000cc000","00077000","00cccc00",
      "00c7c7c0","00cccc00","000cc000","000cc000"}, -- tall blue
 [6]={"00000000","00055000","00555550","05565550",
      "05555550","00555500","00000000","00000000"}, -- driftwood
 [7]={"00000000","00011000","001cc100","01c11c10",
      "01c11c10","001cc100","00011000","00000000"}, -- whirlpool
 [8]={"00088000","00888800","08877880","08877880",
      "08877880","08877880","00888800","00088000"}, -- life ring
}
function put_sprite(n,rows)
 local ox=(n%16)*8
 local oy=flr(n/16)*8
 for y=0,7 do for x=0,7 do
  sset(ox+x,oy+y,tonum("0x"..sub(rows[y+1],x+1,x+1)))
 end end
end

-- levels ---------------------------------------------------------------
local levels={
 {creatures=3,maxcarry=2,period=120,phase=0, gapx=70,gapw=16,hazards=0,timeleft=999},
 {creatures=4,maxcarry=2,period=95, phase=40,gapx=58,gapw=13,hazards=1,timeleft=999},
 {creatures=5,maxcarry=2,period=72, phase=20,gapx=84,gapw=11,hazards=2,timeleft=999},
}

local LEFT_X=12
local RIGHT_X=118
local RIVER_X0=28
local RIVER_X1=102
local WATER_TOP=30
local WATER_BOT=104

local state, crs, t, flash, msg, msgT
local save_id="ferry_creek_v1"
local SLOT_BEST,SLOT_SCHEMA=0,1
local best, save_writable
local lvl, levelIdx, gapx, gapw, period, phase, maxcarry
local hazards, boat, carryCount
local rescuedTotal

function _init()
 srand(7)
 pal() palt()
 for i=1,8 do put_sprite(i,S[i]) end
 write_sfx(SFX_LOAD,{{32,0,4,0},{36,0,4,1}},10)
 write_sfx(SFX_UNLOAD,{{40,0,4,2},{36,0,4,2}},10)
 write_sfx(SFX_PICK,{{45,3,3,0},{48,3,3,0}},12)
 write_sfx(SFX_DROP,{{36,2,4,3},{30,2,4,3},{24,2,3,3}},10)
 write_sfx(SFX_SPLASH,{{20,6,4,5},{16,6,3,5}},8)
 write_sfx(SFX_RESCUE,{{36,5,3,0},{43,5,3,0},{48,5,4,0}},8)
 write_sfx(SFX_LOSE,{{30,2,4,2},{24,2,4,2},{17,2,4,2},{12,2,3,2}},10)
 write_sfx(SFX_CLEAR,{{40,5,4,0},{45,5,4,0},{52,5,4,0},{57,5,5,6}},8)
 write_sfx(SFX_START,{{36,0,4,1},{43,0,4,1},{48,0,5,0}},10)
 write_sfx(SFX_WARN,{{55,3,2,0}},6)
 cartdata(save_id)
 local ver=dget(SLOT_SCHEMA)
 save_writable=ver==0 or ver==1
 best=mid(0,flr(dget(SLOT_BEST)),99999)
 if ver==0 then dset(SLOT_BEST,best) dset(SLOT_SCHEMA,1) end
 t=0 flash=0 msg="" msgT=0 rescuedTotal=0
 state="title"
 start_level(1)
 state="title"
end

function start_level(idx)
 levelIdx=idx
 lvl=levels[idx]
 if not lvl then state="win" sfx(SFX_CLEAR,3) return end
 maxcarry=lvl.maxcarry
 period=lvl.period
 phase=lvl.phase
 gapx=lvl.gapx
 gapw=lvl.gapw
 hazards={}
 for i=1,lvl.hazards do
  hazards[i]={px=34+i*22,ph=(i*37)%period,x=0,y=0}
 end
 crs={}
 for i=1,lvl.creatures do
  add(crs,{kind=1+flr(rnd(3)),side=0,done=false,bob=rnd(1),x=-20,y=0})
 end
 boat={x=LEFT_X,y=64,carry={},dir=1}
 carryCount=0
 state="play"
 flash=0
 timer=0
 set_msg("RESCUE "..#crs.." CREATURES",100)
 sfx(SFX_START,3)
 layout_creatures()
end

function layout_creatures()
 local leftN,rightN=0,0
 for i=1,#crs do
  local c=crs[i]
  if c.done then
   c.x=-20 c.y=0
  elseif c.side==0 then
   c.x=2+(leftN%2)*8
   c.y=42+flr(leftN/2)*14
   leftN+=1
  else
   c.x=118+(rightN%2)*8
   c.y=40+flr(rightN/2)*14
   rightN+=1
  end
 end
end

function set_msg(m,d) msg=m msgT=d or 80 end

function water_safe(px)
 if gapw<=0 then return false end
 return px>=gapx and px<=gapx+gapw
end

function surge_at(tt)
 local p=(tt+phase)%period
 local half=period*0.5
 if p<half then return p/half else return (period-p)/half end
end

-- pick up / drop --------------------------------------------------------
function try_pick_or_drop()
 -- on left bank: board
 if boat.x<=LEFT_X+2 then
  if carryCount<maxcarry then
   -- find available creature at left bank
   for i=1,#crs do
    local c=crs[i]
    if not c.done and c.side==0 then
     c.side=1        -- now in boat
     add(boat.carry,c)
     carryCount+=1
     boat.dir=1
     sfx(SFX_PICK,3)
     layout_creatures()
     set_msg("BOARDED ("..carryCount.."/"..maxcarry..")",40)
     return
    end
   end
   set_msg("NO CREATURES HERE",30)
  else
   set_msg("BOAT FULL",30)
  end
 else
  set_msg("DOCK AT LEFT BANK TO BOARD",30)
 end
end

function unload_all()
 for i=#boat.carry,1,-1 do
  local c=boat.carry[i]
  c.side=2
  c.done=true
  rescuedTotal+=1
  del(boat.carry,c)
 end
 carryCount=0
 sfx(SFX_RESCUE,3)
 layout_creatures()
 set_msg("SAFE!",40)
end

function _update60()
 t+=1
 if flash>0 then flash-=1 end
 if msgT>0 then msgT-=1 end

 if state=="title" then
  if btnp(4) or btnp(5) then start_level(1) end
  return
 elseif state=="win" then
  if btnp(4) or btnp(5) then start_level(1) end
  return
 elseif state=="fail" then
  if btnp(4) or btnp(5) then start_level(levelIdx) end
  return
 elseif state=="clearing" then
  if t-clear_t>40 then
   if levelIdx+1>#levels then
    -- update best on full win
    if rescuedTotal>best then
     best=rescuedTotal
     if save_writable then dset(SLOT_BEST,best) end
    end
    state="win"
    sfx(SFX_CLEAR,3)
   else
    start_level(levelIdx+1)
   end
  end
  for i=1,#crs do crs[i].bob+=0.08 end
  return
 elseif state~="play" then
  return
 end

 -- play
 timer+=1
 local sp=1.5
 if btn(0) then boat.x-=sp end
 if btn(1) then boat.x+=sp end
 if btn(2) then boat.y-=sp end
 if btn(3) then boat.y+=sp end
 boat.x=mid(LEFT_X,boat.x,RIGHT_X)
 boat.y=mid(WATER_TOP+3,boat.y,WATER_BOT-3)

 local overwater = boat.x>RIVER_X0 and boat.x<RIVER_X1
 local surge=surge_at(t)
 local endanger = overwater and (not water_safe(boat.x)) and surge>0.6

 for i=1,#hazards do
  local hz=hazards[i]
  hz.x=hz.px+sin((t+hz.ph)*0.028)*20
  hz.y=boat.y
  if overwater and abs(boat.x-hz.x)<7 and abs(boat.y-hz.y)<10 then
   endanger=true
  end
 end

 if overwater and (not water_safe(boat.x)) and surge>0.48 and surge<0.6 and t%18==0 then
  sfx(SFX_WARN,3)
 end

 if endanger then
  if carryCount>0 then
   sfx(SFX_SPLASH,3)
   flash=24
   -- lose passengers back to left bank
   for i=#boat.carry,1,-1 do
    local c=boat.carry[i]
    c.side=0
    del(boat.carry,c)
   end
   carryCount=0
   layout_creatures()
   boat.x = boat.dir>0 and LEFT_X or RIGHT_X
   set_msg("WASHED OUT! PASSENGERS LOST",100)
   timer=0
  else
   -- empty boat pushed back
   boat.x = boat.dir>0 and LEFT_X or RIGHT_X
   set_msg("TOO ROUGH - TURNED BACK",60)
   timer=0
   sfx(SFX_WARN,3)
  end
  boat.carry={}
  carryCount=0
 end

 if btnp(5) and not endanger then try_pick_or_drop() end

 if boat.x>=RIGHT_X-0.5 and carryCount>0 then
  boat.dir=-1
  unload_all()
 end

 -- win check
 local allDone=true
 for i=1,#crs do if not crs[i].done then allDone=false break end end
 if allDone then
  state="clearing"
  clear_t=t
  sfx(SFX_CLEAR,3)
 end
end

-- drawing ---------------------------------------------------------------
function _draw()
 if state=="title" then draw_title() return end
 draw_world()
 if state=="win" then draw_win() return end
 if state=="fail" then draw_fail() return end
 draw_hud()
end

function draw_title()
 cls(1)
 -- water band
 rectfill(0,40,127,88,12)
 for i=0,10 do
  local yy=44+i*4+sin(t*0.05+i)*2
  line(sin(t*0.03+i)*8,yy,127-sin(t*0.03+i)*8,yy,13)
 end
 spr(3,20,58+sin(t*0.1)*2)
 spr(4,100,60+sin(t*0.1+1)*2)
 spr(2,58,58+sin(t*0.08)*2)
 print("ferry creek",28,14,7)
 print("rescue the stranded",22,26,6)
 if t%60<40 then print("press \24 to start",36,100,10) end
 print("arrows move  \32 board/unload",8,112,7)
 print("best rescued: "..best,32,120,11)
end

function draw_world()
 cls(3) -- dark green banks
 -- banks
 rectfill(0,0,127,127,3)
 -- water
 rectfill(RIVER_X0,WATER_TOP,RIVER_X1,WATER_BOT,1)
 -- waves
 for i=0,14 do
  local yy=WATER_TOP+4+i*5
  local ph=(t*0.06+i*0.7)
  line(RIVER_X0+2+sin(ph)*3,yy,RIVER_X1-2+sin(ph+2)*3,yy,12)
 end
 -- safety island in the middle (gap)
 if gapw>0 then
  local iy=64
  rectfill(gapx,44,gapx+gapw,84,3)
  rectfill(gapx+1,45,gapx+gapw-1,83,11)
  print("\^",gapx+gapw/2-2,60,7)
 end
 -- surge glow over unsafe river
 local surge=surge_at(t)
 if surge>0.5 and (gapw<=0 or true) then
  local a=flr((surge-0.5)*2*6)+1
  for i=0,6 do
   local yy=WATER_TOP+4+i*10
   line(RIVER_X0+2,yy,RIVER_X1-2,yy,12)
  end
 end
 -- hazards
 for i=1,#hazards do
  local hz=hazards[i]
  if hz.x then
   spr(7,hz.x-4,hz.y-4)
  end
 end
 -- docks
 rectfill(0,40,20,108,4)
 rectfill(108,36,127,112,4)
 line(0,44,20,44,9) line(0,104,20,104,9)
 line(108,40,127,40,9) line(108,108,127,108,9)
 -- creatures
 for i=1,#crs do
  local c=crs[i]
  if c.x>=0 then
   if c.side==0 then spr(2+c.kind,c.x,c.y+sin(c.bob)*1.5,1,1,false)
   elseif c.side==2 then spr(2+c.kind,c.x,c.y+sin(c.bob)*1.5) end
  end
 end
 -- boat
 local bx=boat.x-4
 local by=boat.y-4
 spr(carryCount>0 and 2 or 1,bx,by)
 -- carried creatures peeking
 if carryCount>0 then
  spr(2+crs[1].kind,bx,by-4)
 end
 -- flash on splash
 if flash>0 then
  for i=0,3 do
   circ(boat.x,boat.y,4+i*4+flr((24-flash)/2),7)
  end
 end
 -- message
 if msgT>0 then
  local w=#msg*4
  print(msg,64-w/2,2,10)
 end
end

function draw_hud()
 -- danger meter bottom
 local surge=surge_at(t)
 local overwater=boat.x>RIVER_X0 and boat.x<RIVER_X1
 rectfill(0,110,127,127,0)
 print("safety",4,114,6)
 local bx=40
 local bw=80
 rectfill(bx,114,bx+bw,124,8)
 local safeW = 1-surge
 rectfill(bx,114,bx+bw*safeW,124,11)
 if overwater and not water_safe(boat.x) and surge>0.5 then
  print("DANGER",bx+bw-26,114,10)
 end
 -- capacity rings
 print("crew",4,122,6)
 for i=1,maxcarry do
  local px=24+(i-1)*9
  spr(8,px,118)
  if i<=carryCount then rectfill(px+2,120,px+5,123,8) end
 end
 -- level
 print("LV "..levelIdx,100,122,7)
 print("rescued "..rescuedTotal,44,122,6)
end

function draw_fail()
 rectfill(20,46,108,82,0)
 rectfill(22,48,106,80,2)
 print("HIT THE CURRENT!",30,54,7)
 print("press \24 retry",38,68,10)
end

function draw_win()
 rectfill(20,46,108,82,0)
 rectfill(22,48,106,80,3)
 print("ALL SAFE!",42,54,10)
 print("rescued: "..rescuedTotal,34,66,7)
 print("press \24 again",36,74,11)
end


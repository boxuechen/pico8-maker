pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- COURIER: one-screen parcel delivery platformer
-- arrows: move   z/o: jump (variable height)   x: drop parcel / pick up

local SAVE_ID="courier_delivery_v1"
SLOT_VER=0
SLOT_BEST=1
SLOT_EASY=2

-- ---------- sprite art ----------
function put_sprite(n,rows)
 local ox=(n%16)*8
 local oy=flr(n/16)*8
 for y=0,7 do
  local r=rows[y+1]
  for x=0,7 do
   local c=tonum("0x"..sub(r,x+1,x+1))
   sset(ox+x,oy+y,c)
  end
 end
end

ART={}
ART[1]={"00000000","00033300","00377730","030f0f30","03777730","00377700",
        "00303030","00300300"}
ART[2]={"00000000","00033300","00377730","030f0f30","03777730","00377700",
        "00303030","03030300"}
ART[3]={"00000000","07777770","07000070","07777770","07000070","07777770",
        "00000000","00000000"}
ART[4]={"44444444","47777774","47777774","44444444","44744744","47777774",
        "47777774","44444444"}
ART[5]={"47777774","4b7bb7b4","44444444","74777747","74777747","44444444",
        "47777774","44444444"}
ART[6]={"00000000","00066000","00066000","00666600","00666600","06666660",
        "06666660","66666666"}
ART[7]={"00aaaa00","0aa77aa0","0a7777a0","0a7777a0","0a7777a0","0a7777a0",
        "0a7777a0","0aaaaaa0"}
ART[8]={"00000000","000a0000","000a0000","0aaaaaa0","00aaa000","00aaa000",
        "0aa00aa0","00000000"}
ART[9]={"00111100","01100110","01066010","01066010","01066010","01066010",
        "01066010","01111110"}
ART[10]={"00000000","00066000","00666660","66666666","06666660","00000000",
        "00000000","00000000"}
ART[11]={"00000000","00000000","07777770","07000070","07000070","07777770",
        "00000000","00000000"}
ART[12]={"00000000","00033300","00377730","030f0f30","03777730","00377700",
        "00303030","00300300"}

-- ---------- level ----------
LVL={}
LVL[1] ="1111111111111111"
LVL[2] ="1000000000000001"
LVL[3] ="1000000000000001"
LVL[4] ="1000000011000001"
LVL[5] ="1000000000000001"
LVL[6] ="1001100000000001"
LVL[7] ="1000000000110001"
LVL[8] ="1000000000000001"
LVL[9] ="1111000000000001"
LVL[10]="1000000011111001"
LVL[11]="1000000000000001"
LVL[12]="1000000000000001"
LVL[13]="1000011000000001"
LVL[14]="1000000000001101"
LVL[15]="1000000111101111"
LVL[16]="1111111111111111"

TILE=8
MAPY=8

function solid_at(tx,ty)
 if tx<0 or tx>15 or ty<0 or ty>15 then return true end
 local r=LVL[ty+1]
 local ch=sub(r,tx+1,tx+1)
 return ch=="1"
end

function tile_id(tx,ty)
 if not solid_at(tx,ty) then return 0 end
 if solid_at(tx,ty-1) then return 4 else return 5 end
end

function rect_hits_wall(x,y,w,h)
 local x0=flr(x/TILE)
 local x1=flr((x+w-1)/TILE)
 local y0=flr((y-MAPY)/TILE)
 local y1=flr((y+h-1-MAPY)/TILE)
 for ty=y0,y1 do
  for tx=x0,x1 do
   if solid_at(tx,ty) then return true end
  end
 end
 return false
end

-- ---------- sound ----------
function write_sfx(id,notes,speed)
 local base=0x3200+id*68
 memset(base,0,68)
 for i=1,#notes do
  if i>32 then break end
  local n=notes[i]
  poke(base+(i-1)*2,n[1]+(n[2]%4)*64)
  poke(base+(i-1)*2+1,flr(n[2]/4)+n[3]*2+n[4]*16)
 end
 poke(base+65,speed)
end

function sfx_init_once()
 write_sfx(0,{{32,1,3,1},{36,1,3,1},{40,1,2,2}},6)
 write_sfx(1,{{20,2,3,0},{16,2,2,3}},8)
 write_sfx(2,{{60,0,4,0},{64,0,4,0},{67,0,4,0},{72,0,3,3}},5)
 write_sfx(3,{{48,0,4,0},{52,0,4,0},{55,0,4,0},{60,0,4,3},{0,0,0,0},{60,0,4,0},{64,0,4,0},{67,0,3,3}},5)
 write_sfx(4,{{36,3,4,2},{33,3,4,2},{30,3,3,2},{24,3,3,6}},7)
 write_sfx(5,{{12,3,1,0}},6)
 write_sfx(6,{{28,2,3,4},{24,2,2,3}},7)
 write_sfx(7,{{44,0,3,1},{48,0,3,0}},7)
 local bass={}
 local lead={}
 local bl={12,12,19,19,12,12,15,15}
 local ll={27,30,27,32}
 for i=1,32 do
  add(bass,{bl[1+flr((i-1)/4)%8],2,1,0})
  add(lead,{ll[1+flr((i-1)/2)%4],1,1,0})
 end
 write_sfx(8,bass,10)
 write_sfx(9,lead,10)
 local base=0x3100
 poke(base,8+128)
 poke(base+1,9+128)
 poke(base+2,64)
 poke(base+3,64)
 music(0,0,3)
end

-- ---------- init ----------
function _init()
 cartdata(SAVE_ID)
 local v=dget(SLOT_VER)
 if v<1 then
  if v==0 then dset(SLOT_BEST,0) end
  dset(SLOT_EASY,0)
  dset(SLOT_VER,1)
 end
 best_score=mid(0,flr(dget(SLOT_BEST)),9999)
 easy_mode=(dget(SLOT_EASY)>=1)

 srand(7)
 for k=1,12 do put_sprite(k,ART[k]) end
 sfx_init_once()
 timer=0
 particles={}
 sparkle=0
 foot=0
 init_level()
 msg=""
 msg_timer=0
 shake=0
end

function init_level()
 p={x=16,y=112,w=6,h=8,face=1,anim=0,holding=false,vx=0,vy=0,on_ground=false}
 parcel={x=96,y=40,vy=0,landed=false,held=false,w=8,h=6}
 door={x=112,y=112,w=16,h=16}
 stars={}
 add(stars,{x=28,y=80,taken=false,risky=false})
 add(stars,{x=92,y=48,taken=false,risky=false})
 add(stars,{x=52,y=16,taken=false,risky=true})
 hazards={}
 for tx=7,10 do add(hazards,{x=tx*TILE,y=15*TILE-3,w=8,h=6}) end
 score=0
 stars_got=0
 respawn_t=0
 jumpbuf=0
 coyote=0
end

-- ---------- helpers ----------
function box_hit(a,b)
 return a.x<b.x+b.w and a.x+a.w>b.x and a.y<b.y+b.h and a.y+a.h>b.y
end

function add_particles(x,y,c,n)
 for i=1,n do
  add(particles,{x=x,y=y,vx=rnd(2)-1,vy=-rnd(2),life=10+rnd(10),c=c})
 end
end

function move_actor(a,gravity)
 a.x+=a.vx
 if rect_hits_wall(a.x,a.y,a.w,a.h) then
  local step=(a.vx>0 and -1 or 1)
  while rect_hits_wall(a.x,a.y,a.w,a.h) do a.x+=step end
  a.vx=0
 end
 a.vy=mid(-8,a.vy+gravity,5)
 a.y+=a.vy
 if rect_hits_wall(a.x,a.y,a.w,a.h) then
  local step=(a.vy>0 and -1 or 1)
  while rect_hits_wall(a.x,a.y,a.w,a.h) do a.y+=step end
  if a.vy>0 then a.on_ground=true else a.on_ground=false end
  a.vy=0
 else
  a.on_ground=false
 end
 a.x=mid(TILE,a.x,15*TILE-a.w)
end

function hit_hazard(a)
 for hz in all(hazards) do
  if box_hit(a,hz) then return true end
 end
 if a.y>MAPY+16*TILE then return true end
 return false
end

-- ---------- update ----------
function _update60()
 timer+=1
 if msg_timer>0 then msg_timer-=1 end
 shake=max(0,shake-0.6)
 sparkle+=0.15
 for i=#particles,1,-1 do
  local q=particles[i]
  q.x+=q.vx q.y+=q.vy q.vy+=0.25 q.life-=1
  if q.life<=0 then del(particles,q) end
 end

 if state=="play" then
  local accel=easy_mode and 0.6 or 0.5
  local maxspd=easy_mode and 1.5 or 1.9
  if btn(0) then p.vx=max(p.vx-accel,-maxspd) p.face=-1 end
  if btn(1) then p.vx=min(p.vx+accel,maxspd) p.face=1 end
  if not (btn(0) or btn(1)) then p.vx*=0.6 end

  if p.on_ground then coyote=6 else coyote=max(0,coyote-1) end
  if btnp(4) then jumpbuf=8 else jumpbuf=max(0,jumpbuf-1) end
  if jumpbuf>0 and coyote>0 then
   p.vy=-4.1
   jumpbuf=0
   coyote=0
   p.on_ground=false
   sfx(0,2,0,2)
   add_particles(p.x+3,p.y+p.h,4,6)
  end
  if not btn(4) and p.vy<-1.6 then p.vy*=0.7 end

  if btnp(5) then
   if p.holding then
    p.holding=false
    parcel.held=false
    parcel.x=p.x+1
    parcel.y=p.y+p.h
    parcel.vy=1.5
    parcel.landed=false
    sfx(6,2,0,2)
    msg="PARCEL DROPPED" msg_timer=60
   elseif not parcel.held and parcel.landed and
          abs(parcel.x-(p.x+p.w/2))<11 and
          abs(parcel.y-(p.y+p.h))<12 then
    p.holding=true
    parcel.held=true
    sfx(7,2,0,1)
    msg="" msg_timer=0
   end
  end

  move_actor(p,0.32)
  p.anim+=abs(p.vx)*0.7

  if not parcel.held then
   if not parcel.landed then
    parcel.vy=min(parcel.vy+0.34,4)
    parcel.y+=parcel.vy
    if rect_hits_wall(parcel.x,parcel.y,parcel.w,parcel.h) then
     local step=(parcel.vy>0 and -1 or 1)
     while rect_hits_wall(parcel.x,parcel.y,parcel.w,parcel.h) do parcel.y+=step end
     if parcel.vy>0 then parcel.landed=true end
     parcel.vy=0
    end
    local lost=false
    for hz in all(hazards) do
     if box_hit(parcel,hz) then lost=true end
    end
    if parcel.y>MAPY+16*TILE then lost=true end
    if lost then
     shake=6
     msg="PARCEL LOST!" msg_timer=200
     sfx(4,2,0,2)
     lose_parcel()
    end
   end
  else
   parcel.x=p.x-1
   parcel.y=p.y-10
  end

  if p.on_ground and abs(p.vx)>1.5 then
   foot+=1
   if foot%22==0 then sfx(5,2,0,1) end
  end

  for s in all(stars) do
   if not s.taken then
    local sb={x=s.x-1,y=s.y-2,w=10,h=11}
    if box_hit(p,sb) or (parcel.landed and box_hit(parcel,sb)) then
     s.taken=true
     stars_got+=1
     score+=s.risky and 3 or 1
     sfx(2,3,0,2)
     add_particles(s.x+3,s.y+3,10,10)
    end
   end
  end

  if hit_hazard(p) then die() end

  local db={x=door.x+2,y=door.y,w=door.w-4,h=door.h}
  if p.holding and box_hit(p,db) then win() end

 elseif state=="dead" then
  respawn_t-=1
  if respawn_t<=0 then restart_level() end
 elseif state=="won" then
  if btnp(5) or btnp(4) then restart_level() end
 end
end

function lose_parcel()
 parcel.x=96 parcel.y=40 parcel.vy=0
 parcel.landed=false parcel.held=false
 p.holding=false
end

function die()
 if state!="play" then return end
 state="dead"
 respawn_t=50
 shake=7
 sfx(4,2,0,2)
 add_particles(p.x+3,p.y+4,14,8)
 msg="OUCH!" msg_timer=60
end

function win()
 state="won"
 sfx(3,1,0,4)
 add_particles(door.x+8,door.y+8,20,10)
 score+=10
 if score>best_score then
  best_score=score
  dset(SLOT_BEST,best_score)
 end
 msg="DELIVERED!"
 msg_timer=400
end

function restart_level()
 state="play"
 init_level()
 msg=""
 msg_timer=0
end

-- ---------- draw ----------
function _draw()
 rectfill(0,0,127,127,12)
 rectfill(0,40,127,127,1)
 local t=flr(timer/3)
 for i=0,2 do
  local cx=((i*52+t)%176)-24
  sspr(80,0,8,6,cx,8+i*11,24,18)
 end

 local sh=shake>0 and (rnd(2)-1)*shake or 0
 local shy=shake>0 and (rnd(2)-1)*shake or 0
 camera(-sh,-shy)

 for ty=0,15 do
  for tx=0,15 do
   local id=tile_id(tx,ty)
   if id>0 then spr(id,tx*TILE,ty*TILE+MAPY) end
  end
 end
 for hz in all(hazards) do
  spr(6,hz.x-2,hz.y-4)
 end

 spr(p.holding and 7 or 9,door.x,door.y)
 if p.holding then
  local g=sin(sparkle)*1.5+2
  circfill(door.x+8,door.y+8,g,10)
 end

 for s in all(stars) do
  if not s.taken then
   local bob=flr(sin(timer/20+s.x)*1)
   spr(8,s.x,s.y+bob)
  end
 end

 if not parcel.held then
  local bob=parcel.landed and flr(sin(timer/18)) or 0
  spr(11,flr(parcel.x),flr(parcel.y)+bob)
 end

 if state!="dead" then
  local sprn
  if abs(p.vx)>0.3 then sprn=1+flr(p.anim/5)%2 else sprn=1 end
  local fl=p.face<0
  spr(sprn,flr(p.x)-1,flr(p.y)-3,1,1,fl,false)
  if p.holding then
   spr(3,flr(p.x)+(p.face<0 and -6 or 4),flr(p.y)-5)
  end
 end

 for q in all(particles) do
  pset(q.x,q.y,q.c)
  if q.life>6 then pset(q.x+1,q.y,q.c) end
 end
 camera()

 rectfill(0,0,127,8,0)
 print("score "..score,2,1,10)
 print("stars "..stars_got.."/3",52,1,11)
 if p.holding then print("parcel",102,1,9) end

 if msg_timer>0 and msg!="" then
  local mw=#msg*4+8
  rectfill(64-mw/2,50,64+mw/2,62,0)
  print(msg,64-#msg*2,53,(msg=="DELIVERED!") and 11 or 10)
 end

 if state=="won" then
  rectfill(14,42,113,86,0)
  rectfill(14,42,113,43,11)
  rectfill(14,85,113,86,11)
  print("DELIVERED!",38,46,11)
  print("score "..score,44,58,7)
  print("stars "..stars_got.."/3",44,66,9)
  if score>=best_score then print("new best!",42,74,10) end
  print("press z to retry",26,78,6)
 end
end


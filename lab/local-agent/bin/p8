#!/usr/bin/env node
// PICO-8 checker on the real disk; the same runP8 backs the agent's virtual `p8`.
import { ReadWriteFs } from "just-bash";
import { join } from "node:path";
import { runP8, SKILL_DIR } from "../src/maker.mjs";
const r = await runP8(process.argv.slice(2), {
  fs: new ReadWriteFs({ root: "/" }),
  cwd: process.cwd(),
  templateDir: join(SKILL_DIR, "templates"),
});
process.stdout.write(r.stdout);
process.exitCode = r.exitCode;

pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- sweet garden
-- swap flowers, match 3, chain, reach the goal

local TS=12
local BX=16
local BY=20
local N=8
local GOAL0=500
local MOVES0=14

local g={}
local fy={}
local pop={}
local swx={}
local swy={}
local cx=4
local cy=4
local sel=nil
local state="idle"
local tmr=0
local score=0
local moves=MOVES0
local goal=GOAL0
local chain=0
local hinta=nil
local hintb=nil
local idle=0
local msgtxt=""
local msgt=0
local btxt="MATCH 3 FLOWERS"
local bt=0
local parts={}
local floats={}
local swapA=0
local swapB=0
local frame=0

local tcols={14,7,12,13,9}

function ix(x,y) return x+(y-1)*N end
function cellxy(i) return (i-1)%N+1,flr((i-1)/N)+1 end
function rprint(s,xr,y,c) print(s,xr-(#s*5-1),y,c) end
function ctext(s,y,c) print(s,64-(#s*5-1)/2,y,c) end

function findmatches()
  local m={}
  local cnt=0
  for y=1,N do
    local run=1
    for x=2,N+1 do
      if x<=N and g[ix(x,y)]==g[ix(x-1,y)] and g[ix(x-1,y)]>0 then
        run+=1
      else
        if run>=3 then
          for k=0,run-1 do
            local i=ix(x-1-k,y)
            if not m[i] then m[i]=true cnt+=1 end
          end
        end
        run=1
      end
    end
  end
  for x=1,N do
    local run=1
    for y=2,N+1 do
      if y<=N and g[ix(x,y)]==g[ix(x,y-1)] and g[ix(x,y-1)]>0 then
        run+=1
      else
        if run>=3 then
          for k=0,run-1 do
            local i=ix(x,y-1-k)
            if not m[i] then m[i]=true cnt+=1 end
          end
        end
        run=1
      end
    end
  end
  return m,cnt
end

function findhint()
  for y=1,N do
    for x=1,N do
      local i=ix(x,y)
      for d=0,1 do
        local x2=x+d
        local y2=y+1-d
        if x2<=N and y2<=N then
          local j=ix(x2,y2)
          if g[i]~=g[j] then
            g[i],g[j]=g[j],g[i]
            local m,c=findmatches()
            g[i],g[j]=g[j],g[i]
            if c>0 then return i,j end
          end
        end
      end
    end
  end
end

function resetboard()
  local tries=0
  local ok=false
  repeat
    tries+=1
    for y=1,N do
      for x=1,N do
        local tp
        repeat
          tp=flr(rnd(5))+1
        until not ((x>2 and g[ix(x-1,y)]==tp and g[ix(x-2,y)]==tp) or (y>2 and g[ix(x,y-1)]==tp and g[ix(x,y-2)]==tp))
        g[ix(x,y)]=tp
      end
    end
    local m,c=findmatches()
    ok=c==0 and findhint()~=nil
  until ok or tries>40
  for i=1,N*N do
    fy[i]=0
    pop[i]=0
    swx[i]=0
    swy[i]=0
  end
end

function drawflower(tp,x,y,s)
  if s<=0 then return end
  if tp==1 then
    for a=0,3 do
      local ang=a*0.25+0.125
      circfill(x+cos(ang)*3*s,y+sin(ang)*3*s,2*s,14)
    end
    circfill(x,y,2*s,8)
    circfill(x-0.5,y-0.5,1*s,7)
  elseif tp==2 then
    for a=0,5 do
      local ang=a/6
      circfill(x+cos(ang)*3*s,y+sin(ang)*3*s,1.6*s,7)
    end
    circfill(x,y,1.8*s,10)
    circfill(x,y,0.8*s,9)
  elseif tp==3 then
    circfill(x-2*s,y-1*s,2*s,12)
    circfill(x+2*s,y-1*s,2*s,12)
    circfill(x,y+2*s,2*s,12)
    circfill(x,y-1.5*s,1.4*s,6)
  elseif tp==4 then
    circfill(x,y-3*s,1.8*s,13)
    circfill(x,y+3*s,1.8*s,13)
    circfill(x-3*s,y,1.8*s,13)
    circfill(x+3*s,y,1.8*s,13)
    circfill(x,y,1.6*s,2)
    circfill(x,y,0.7*s,15)
  else
    for a=0,7 do
      local ang=a/8+0.0625
      circfill(x+cos(ang)*3*s,y+sin(ang)*3*s,1.3*s,9)
    end
    circfill(x,y,2*s,4)
    circfill(x,y,1*s,10)
  end
end

function corners(x,y,w,h,c)
  local s=3
  line(x,y,x+s,y,c) line(x,y,x,y+s,c)
  line(x+w,y,x+w-s,y,c) line(x+w,y,x+w,y+s,c)
  line(x,y+h,x+s,y+h,c) line(x,y+h,x,y+h-s,c)
  line(x+w,y+h,x+w-s,y+h,c) line(x+w,y+h,x+w,y+h-s,c)
end

function bloom(px,py,c)
  for k=1,3 do
    add(parts,{x=px+rnd(6)-3,y=py+rnd(6)-3,vx=rnd(1.6)-0.8,vy=rnd()-1.6,g=0.12,t=10+flr(rnd(10)),c=c})
  end
end

function updateparts()
  for i=#parts,1,-1 do
    local p=parts[i]
    p.x+=p.vx
    p.y+=p.vy
    p.vy+=p.g
    p.t-=1
    if p.t<=0 or p.y>132 then deli(parts,i) end
  end
  for i=#floats,1,-1 do
    local f=floats[i]
    f.y-=0.4
    f.t-=1
    if f.t<=0 then deli(floats,i) end
  end
end

function msg(s,d)
  msgtxt=s
  msgt=d
end

function startswap(i,j)
  g[i],g[j]=g[j],g[i]
  local x1,y1=cellxy(i)
  local x2,y2=cellxy(j)
  swx[i]=(x2-x1)*TS swy[i]=(y2-y1)*TS
  swx[j]=(x1-x2)*TS swy[j]=(y1-y2)*TS
  swapA=i swapB=j
  sel=nil
  state="swap" tmr=8
  sfx(5,3)
end

function finishswap()
  for i=1,N*N do swx[i]=0 swy[i]=0 end
  if state=="swapback" then
    state="idle" idle=0
    return
  end
  local m,c=findmatches()
  if c>0 then
    moves-=1
    chain=0
    startpop(m,c)
  else
    g[swapA],g[swapB]=g[swapB],g[swapA]
    local x1,y1=cellxy(swapA)
    local x2,y2=cellxy(swapB)
    swx[swapA]=(x2-x1)*TS swy[swapA]=(y2-y1)*TS
    swx[swapB]=(x1-x2)*TS swy[swapB]=(y1-y2)*TS
    state="swapback" tmr=6
    sfx(6,3)
  end
end

function startpop(m,c)
  chain+=1
  local pts=c*10*chain
  score=min(9999,score+pts)
  local sx,sy,ct=0,0,0
  for i in pairs(m) do
    pop[i]=6
    local x,y=cellxy(i)
    sx+=BX+(x-1)*TS+6
    sy+=BY+(y-1)*TS+6
    ct+=1
    bloom(BX+(x-1)*TS+6,BY+(y-1)*TS+6,tcols[g[i]])
  end
  if ct>0 then
    add(floats,{x=sx/ct-4,y=sy/ct-4,txt="+"..pts,t=26,c=chain>1 and 14 or 7})
  end
  if chain>1 then msg("CHAIN x"..chain.."!",50) end
  sfx(chain>1 and 8 or 7,3)
  state="pop" tmr=6
end

function collapse()
  for x=1,N do
    local w=N
    for y=N,1,-1 do
      local tp=g[ix(x,y)]
      if tp>0 then
        if w~=y then
          g[ix(x,w)]=tp
          g[ix(x,y)]=0
          fy[ix(x,w)]=-(w-y)*TS
        end
        w-=1
      end
    end
    local k=0
    for y=w,1,-1 do
      k+=1
      g[ix(x,y)]=flr(rnd(5))+1
      pop[ix(x,y)]=0
      fy[ix(x,y)]=-k*TS
    end
  end
end

function finishpop()
  for i=1,N*N do
    if pop[i]>0 then
      g[i]=0
      pop[i]=0
    end
  end
  collapse()
  state="fall"
end

function afterfall()
  local m,c=findmatches()
  if c>0 then
    startpop(m,c)
    return
  end
  chain=0
  if score>=goal then
    score=min(9999,score+moves*20)
    state="win"
    sfx(10,3)
    return
  end
  if moves<=0 then
    state="lose"
    sfx(11,3)
    return
  end
  if not findhint() then
    msg("SHUFFLE!",50)
    resetboard()
    for i=1,N*N do fy[i]=-(24+flr(rnd(48))) end
    state="fall"
    sfx(9,3)
    return
  end
  state="idle" idle=0
end

function handleinput()
  local dxn=0
  local dyn=0
  if btnp(0) then dxn=-1 end
  if btnp(1) then dxn=1 end
  if btnp(2) then dyn=-1 end
  if btnp(3) then dyn=1 end
  if sel==nil then
    if dxn~=0 then cx=mid(1,cx+dxn,N) idle=0 hinta=nil hintb=nil end
    if dyn~=0 then cy=mid(1,cy+dyn,N) idle=0 hinta=nil hintb=nil end
    if btnp(4) or btnp(5) then
      sel=ix(cx,cy)
      idle=0 hinta=nil hintb=nil bt=0
      sfx(4,3)
    end
  else
    if btnp(4) or btnp(5) then
      sel=nil
      idle=0
      sfx(4,3)
    elseif dxn~=0 or dyn~=0 then
      local x1,y1=cellxy(sel)
      local nx=x1+dxn
      local ny=y1+dyn
      if nx>=1 and nx<=N and ny>=1 and ny<=N then
        cx=nx cy=ny
        idle=0 hinta=nil hintb=nil bt=0
        startswap(sel,ix(nx,ny))
      end
    end
  end
  if state=="idle" and idle==70 then
    hinta,hintb=findhint()
  end
end

function newgame()
  score=0 moves=MOVES0 chain=0
  cx=4 cy=4 sel=nil
  parts={} floats={}
  msgt=0 msgtxt=""
  bt=100
  resetboard()
  state="idle" idle=0 tmr=0
end

function _init()
  newgame()
  music(0)
end

function _update()
  frame+=1
  if bt>0 then bt-=1 end
  if msgt>0 then msgt-=1 end

  if state=="win" then
    if frame%5==0 then
      add(parts,{x=rnd(128),y=-4,vx=rnd(2)-1,vy=0.6+rnd(),g=0.04,t=180,c=tcols[flr(rnd(5))+1]})
    end
    if btnp(4) or btnp(5) then newgame() end
  elseif state=="lose" then
    if btnp(4) or btnp(5) then newgame() end
  else
    if state=="idle" then
      idle+=1
      handleinput()
    else
      idle=0
      hinta=nil hintb=nil
    end

    if state=="swap" or state=="swapback" then
      for i=1,N*N do swx[i]*=0.5 swy[i]*=0.5 end
      tmr-=1
      if tmr<=0 then finishswap() end
    elseif state=="pop" then
      tmr-=1
      if tmr<=0 then finishpop() end
    elseif state=="fall" then
      local moving=false
      for i=1,N*N do
        if fy[i]<0 then
          fy[i]+=5
          if fy[i]>=0 then fy[i]=0 else moving=true end
        end
      end
      if not moving then afterfall() end
    end
  end
  updateparts()
end

function bgdeco()
  local pts={{3,30},{8,56},{4,84},{5,110},{121,26},{117,54},{123,82},{119,108}}
  for i=1,#pts do
    local x=pts[i][1]
    local y=pts[i][2]
    line(x,y,x-1,y-3,11)
    line(x,y,x,y-4,11)
    line(x,y,x+2,y-2,7)
  end
end

function drawhud()
  rectfill(0,0,127,13,2)
  print("SCORE "..score,4,1,7)
  rprint("GOAL "..goal,124,1,10)
  rectfill(5,8,122,12,1)
  local w=flr(117*min(score,goal)/goal)
  if w>0 then rectfill(5,8,4+w,12,11) end
  rect(4,7,123,13,6)
end

function drawbottom()
  rectfill(0,120,127,127,2)
  print("MOVES "..moves,4,121,moves<=3 and 8 or 10)
  local s,c
  if msgt>0 then s=msgtxt c=14 elseif sel then s="ARROWS: SWAP" c=11 else s="Z: PICK" c=6 end
  rprint(s,124,121,c)
end

function drawover(win)
  fillp(0xa5a5)
  rectfill(0,0,127,127,0)
  fillp()
  rectfill(12,42,115,90,1)
  rect(12,42,115,90,6)
  rect(14,44,113,88,2)
  if win then
    ctext("GARDEN BLOOM!",48,10)
    ctext("SCORE "..score,60,7)
    ctext("Z: PLAY AGAIN",72,11)
  else
    ctext("OUT OF MOVES",48,8)
    ctext("SCORE "..score.."/"..goal,60,7)
    ctext("Z: TRY AGAIN",72,11)
  end
end

function _draw()
  cls(3)
  bgdeco()
  drawhud()

  rectfill(BX-4,BY-4,BX+99,BY+99,2)
  rectfill(BX-2,BY-2,BX+97,BY+97,5)
  rectfill(BX-1,BY-1,BX+96,BY+96,1)
  for y=1,N do
    for x=1,N do
      local px=BX+(x-1)*TS
      local py=BY+(y-1)*TS
      rectfill(px+1,py+1,px+TS-2,py+TS-2,(x+y)%2==0 and 4 or 3)
    end
  end

  clip(BX,BY,N*TS,N*TS)

  if state=="idle" and hinta and hintb then
    local hc=(flr(frame/6)%2==0) and 11 or 10
    local x1,y1=cellxy(hinta)
    local x2,y2=cellxy(hintb)
    corners(BX+(x1-1)*TS,BY+(y1-1)*TS,TS-1,TS-1,hc)
    corners(BX+(x2-1)*TS,BY+(y2-1)*TS,TS-1,TS-1,hc)
  end

  for y=1,N do
    for x=1,N do
      local i=ix(x,y)
      local tp=g[i]
      if tp>0 then
        local s=1
        if pop[i]>0 then s=tmr/6 end
        drawflower(tp,BX+(x-1)*TS+6+swx[i],BY+(y-1)*TS+6+swy[i]+fy[i],s)
      end
    end
  end

  if sel then
    local x1,y1=cellxy(sel)
    corners(BX+(x1-1)*TS,BY+(y1-1)*TS,TS-1,TS-1,10)
  end
  local blink=flr(frame/8)%2==0
  corners(BX+(cx-1)*TS,BY+(cy-1)*TS,TS-1,TS-1,blink and 7 or 6)

  clip()

  for i=1,#parts do
    local p=parts[i]
    circfill(p.x,p.y,1,p.c)
  end
  for i=1,#floats do
    local f=floats[i]
    print(f.txt,f.x,f.y,f.c)
  end

  drawbottom()

  if bt>0 then
    local w=#btxt*5+8
    local x=64-w/2
    rectfill(x,58,x+w,74,0)
    rect(x,58,x+w,74,10)
    ctext(btxt,62,10)
  end

  if state=="win" then
    drawover(true)
    for i=1,#parts do
      local p=parts[i]
      circfill(p.x,p.y,1,p.c)
    end
  elseif state=="lose" then
    drawover(false)
  end
end


pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- lodge podge
-- chew trees, gather sticks, build a lodge

function _init()
	srand(11)
	p={x=96,y=128,fl=false,mt=0}
	carry,maxcarry=0,4
	lg={x=128,y=128,n=0,need=12}
	trees={} picks={} parts={}
	shk=0 st=0 chp=0 ctar=nil clock=0
	camx=mid(0,p.x-64,128)
	camy=mid(0,p.y-64,128)
	gens()
end

function gens()
	for y=0,31 do
		for x=0,31 do
			local t=32
			local dx,dy=x-6,y-25
			if dx*dx/9+dy*dy/6<1 then
				t=36
			else
				dx,dy=x-26,y-5
				if dx*dx/8+dy*dy/5<1 then t=36 end
			end
			local d=(x-15.5)*(x-15.5)+(y-15.5)*(y-15.5)
			if t==32 and d>13 then
				local r=rnd(1)
				if r<0.1 then t=33
				elseif r<0.15 then t=34 end
			end
			if t==36 and rnd(1)<0.3 then t=37 end
			mset(x,y,t)
		end
	end
	for i=1,22 do
		for a=1,60 do
			local tx=flr(rnd(28))+2
			local ty=flr(rnd(28))+2
			local cx,cy=tx*8+4,ty*8+4
			local m=mget(tx,ty)
			local ok=m~=36 and m~=37 and (cx-128)*(cx-128)+(cy-128)*(cy-128)>1600
			if ok then
				for q in all(trees) do
					if (q.x-cx)*(q.x-cx)+(q.y-cy)*(q.y-cy)<700 then ok=false end
				end
			end
			if ok then
				add(trees,{x=cx,y=cy,hp=46,t=rnd(1),sh=0,fall=0})
				break
			end
		end
	end
	music(0)
end

function solid(x,y)
	if x<8 or x>248 or y<10 or y>248 then return true end
	local m=mget(flr(x/8),flr(y/8))
	if m==36 or m==37 then return true end
	for t in all(trees) do
		if t.fall==0 and (t.x-x)*(t.x-x)+(t.y-y)*(t.y-y)<64 then return true end
	end
	return false
end

function updparts()
	for i=#parts,1,-1 do
		local q=parts[i]
		q.x+=q.vx
		q.y+=q.vy
		local g=q.g
		if g==nil then g=0.18 end
		q.vy+=g
		q.l-=1
		if q.l<=0 then del(parts,q) end
	end
end

function won()
	st=1
	sfx(8,3)
	shk=4
	for k=1,28 do
		add(parts,{x=lg.x+rnd(40)-20,y=lg.y+rnd(24)-12,vx=rnd(1.4)-0.7,vy=-rnd(1.8),c=10,l=52})
	end
end

function _update60()
	clock+=1
	shk*=0.87
	updparts()
	if rnd(1)<0.06 then
		add(parts,{x=camx+rnd(128),y=camy-2,vx=rnd(0.6)-0.3,vy=0.35,c=11,l=200,g=0})
	end
	for i=#trees,1,-1 do
		local t=trees[i]
		if t.fall>0 then
			t.fall+=1
			if t.fall==11 then
				for k=1,3 do
					add(picks,{x=t.x+rnd(14)-7,y=t.y+rnd(8),t=rnd(1)})
				end
				for k=1,8 do
					add(parts,{x=t.x+rnd(10)-5,y=t.y,vx=rnd(1.6)-0.8,vy=-rnd(1.8),c=11,l=26})
				end
			end
			if t.fall>15 then del(trees,t) end
		else
			t.sh*=0.75
		end
	end
	if st==1 then
		if btnp(5) then _init() end
		return
	end
	for s in all(picks) do s.t+=0.09 end
	local tgt,bd=nil,420
	for t in all(trees) do
		if t.fall==0 then
			local d=(t.x-p.x)*(t.x-p.x)+(t.y-p.y)*(t.y-p.y)
			if d<bd then
				bd=d
				tgt=t
			end
		end
	end
	local dx,dy=0,0
	if btn(0) then dx-=1 end
	if btn(1) then dx+=1 end
	if btn(2) then dy-=1 end
	if btn(3) then dy+=1 end
	local chew=btn(5) and tgt~=nil
	if chew then
		if ctar~=tgt then
			chp=0
			ctar=tgt
		end
		chp+=1
		tgt.sh=sin(chp*0.9)*1.8
		if chp%12==0 then
			sfx(4,3)
			add(parts,{x=tgt.x+rnd(8)-4,y=tgt.y+2,vx=rnd(2)-1,vy=-rnd(1.6),c=9,l=18})
		end
		if chp>=tgt.hp then
			tgt.fall=1
			tgt.sh=0
			chp=0
			ctar=nil
			shk=3
			sfx(5,3)
		end
	else
		chp=max(0,chp-4)
		ctar=nil
	end
	if not chew and (dx~=0 or dy~=0) then
		if dx~=0 then p.fl=dx<0 end
		local l=sqrt(dx*dx+dy*dy)
		local nx=p.x+dx/l*1.15
		local ny=p.y+dy/l*1.15
		if not solid(nx,p.y) then p.x=nx end
		if not solid(p.x,ny) then p.y=ny end
		p.mt+=1
	else
		p.mt=0
	end
	for i=#picks,1,-1 do
		local s=picks[i]
		if carry<maxcarry and (s.x-p.x)*(s.x-p.x)+(s.y-p.y)*(s.y-p.y)<170 then
			del(picks,s)
			carry+=1
			sfx(6,3)
			for k=1,6 do
				add(parts,{x=s.x,y=s.y,vx=rnd(2)-1,vy=-rnd(2),c=10,l=16})
			end
		end
	end
	if carry>0 and lg.n<lg.need and (p.x-lg.x)*(p.x-lg.x)+(p.y-lg.y)*(p.y-lg.y)<820 then
		if clock%9==0 then
			carry-=1
			lg.n+=1
			sfx(7,3)
			add(parts,{x=p.x,y=p.y-4,vx=(lg.x-p.x)*0.06,vy=-1.4,c=9,l=22})
			if lg.n>=lg.need then won() end
		end
	end
	camx=mid(0,p.x-64,128)
	camy=mid(0,p.y-64,128)
end

function drawtree(t)
	local x,y=t.x+t.sh,t.y
	local f=t.fall
	local r=7
	if f>0 then
		local u=f/15
		x+=u*9
		y+=u*3
		r=7-u*3
	end
	ovalfill(x-5,y+6,x+5,y+9,2)
	rectfill(x-1,y+2,x+1,y+9,4)
	if r>1 then
		circfill(x,y-2,r,2)
		circfill(x,y-3,r-1,3)
		circfill(x-2,y-5,2,11)
		pset(x+3,y,11)
	end
end

function drawpick(s)
	local x,y=s.x,s.y+sin(s.t)*1.5
	pset(x,y+2,3)
	line(x-3,y+1,x+2,y-2,9)
	line(x-3,y-1,x+3,y+1,4)
	pset(x+2,y-2,7)
end

function drawplayer()
	local x,y=p.x,p.y
	local f=0
	local bob=0
	if chp>0 then
		f=3
		x+=sin(chp*0.8)
	elseif p.mt>0 then
		f=1+flr(p.mt/5)%2
		bob=flr(sin(p.mt*0.45))
	end
	ovalfill(x-6,y+4,x+6,y+6,3)
	sspr(8+f*16,0,16,16,x-8,y-11+bob,16,16,p.fl)
end

function drawlodge()
	local x,y=lg.x,lg.y
	local q=lg.n/lg.need
	ovalfill(x-27,y-9,x+27,y+17,15)
	for i=0,9 do
		local a=i*0.63
		pset(x+cos(a)*20,y+2+sin(a)*9,9)
	end
	if lg.n==0 then
		for i=0,7 do
			local a=i*0.7853
			line(x+cos(a)*14,y+sin(a)*8,x+cos(a)*21,y+sin(a)*12,4)
		end
		return
	end
	local h=3+flr(q*13)
	local w=6+flr(q*9)
	ovalfill(x-w-3,y+3,x+w+3,y+9,2)
	ovalfill(x-w,y+8-h,x+w,y+8,4)
	for i=0,7 do
		local u=i/8
		local yy=y+8-h*u
		local ww=w*sqrt(1-u*u)*1.05
		if ww>1 then line(x-ww,yy,x+ww,yy,i%2==0 and 9 or 4) end
	end
	oval(x-w,y+8-h,x+w,y+8,2)
	if q>0.55 then ovalfill(x-3,y+3,x+3,y+9,0) end
	if q>=1 then
		circfill(x-6,y-h+7,2,11)
		circfill(x+7,y-h+10,2,11)
		pset(x+1,y-h+2,10)
	end
end

function hud()
	rectfill(44,2,92,9,0)
	rect(44,2,92,9,5)
	local w=flr(43*lg.n/lg.need)
	if w>0 then rectfill(47,3,47+w,8,9) end
	print("lodge",2,3,7)
	print(lg.n.."/"..lg.need,95,3,7)
	for i=1,maxcarry do
		local x=3+(i-1)*9
		rect(x,116,x+7,123,5)
		if i<=carry then
			line(x+1,121,x+6,118,4)
			line(x+1,120,x+6,117,9)
		end
	end
	print("sticks",60,118,6)
	local s=nil
	if carry>0 then
		s="carry sticks to the sand"
	elseif ctar then
		s="hold X to chew!"
	end
	if s and st==0 then
		rectfill(0,96,127,105,0)
		print(s,(128-#s*4)/2,98,7)
	end
end

function windraw()
	rectfill(6,86,121,116,0)
	rect(6,86,121,116,9)
	local s="your lodge is done!"
	print(s,(128-#s*4)/2,92,10)
	local s2="press X to build again"
	print(s2,(128-#s2*4)/2,104,7)
end

function _draw()
	cls(3)
	local ox,oy=camx,camy
	if shk>0.2 then
		ox+=rnd(shk)-shk*0.5
		oy+=rnd(shk)-shk*0.5
	end
	camera(flr(ox),flr(oy))
	map(0,0,0,0,32,32)
	drawlodge()
	for t in all(trees) do
		if t.y<=p.y then drawtree(t) end
	end
	for s in all(picks) do drawpick(s) end
	if ctar and chp>0 then
		local t=ctar
		local w=14
		rectfill(t.x-w/2-1,t.y-12,t.x+w/2+1,t.y-8,0)
		rectfill(t.x-w/2,t.y-11,t.x-w/2+w*chp/t.hp,t.y-9,10)
	end
	drawplayer()
	for t in all(trees) do
		if t.y>p.y then drawtree(t) end
	end
	for q in all(parts) do
		local c=q.c
		if q.l<14 then c=7 end
		pset(q.x,q.y,c)
	end
	camera()
	hud()
	if st==1 then windraw() end
end


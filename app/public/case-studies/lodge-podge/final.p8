pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- lodge podge
-- sticks, mud and leaves make a cozy lodge

function _init()
	srand(11)
	p={x=128,y=170,fl=false,mt=0}
	carry={s=0,m=0,l=0}
	need={s=6,m=3,l=3}
	got={s=0,m=0,l=0}
	cap=3
	kinds={"s","m","l"}
	lg={x=128,y=124}
	sources={} picks={} parts={}
	shk=0 mode=0 chp=0 ctar=nil clock=0
	camx=mid(0,p.x-64,128)
	camy=mid(0,p.y-64,128)
	gens()
end

function put(k,x,y,hp)
	local m=mget(flr(x/8),flr(y/8))
	if m==36 or m==37 then
		x+=(lg.x-x)*0.3
		y+=(lg.y-y)*0.3
	end
	add(sources,{k=k,mat=(k=="t" and "s" or k),x=x,y=y,hp=hp,t=rnd(1),sh=0,off=0,oa=0})
end

function gens()
	for y=0,31 do
		for x=0,31 do
			local t=32
			local dx,dy=x-6,y-25
			if dx*dx/9+dy*dy/6<1 then
				t=36
			else
				dx,dy=x-26,y-5
				if dx*dx/8+dy*dy/5<1 then t=36 end
			end
			local d=(x-15.5)*(x-15.5)+(y-15.5)*(y-15.5)
			if t==32 and d>16 then
				local r=rnd(1)
				if r<0.09 then t=33
				elseif r<0.12 then t=34 end
			end
			if t==36 and rnd(1)<0.3 then t=37 end
			mset(x,y,t)
		end
	end
	for i=0,8 do
		local a=i*0.698+0.15
		local rr=66+(i%2)*18
		put("t",128+cos(a)*rr,124+sin(a)*rr*0.92,46)
	end
	for i=0,3 do
		local a=i*1.571+0.7
		put("l",128+cos(a)*50,124+sin(a)*45,26)
	end
	put("m",80,208,34)
	put("m",48,182,34)
	put("m",184,46,34)
	put("m",214,68,34)
	music(0)
end

function solid(x,y)
	if x<8 or x>248 or y<12 or y>246 then return true end
	local m=mget(flr(x/8),flr(y/8))
	if m==36 or m==37 then return true end
	for s in all(sources) do
		if s.k=="t" and s.off==0 and (s.x-x)*(s.x-x)+(s.y-y)*(s.y-y)<64 then return true end
	end
	return false
end

function updparts()
	for i=#parts,1,-1 do
		local q=parts[i]
		q.x+=q.vx
		q.y+=q.vy
		local g=q.g
		if g==nil then g=0.18 end
		q.vy+=g
		q.l-=1
		if q.l<=0 then del(parts,q) end
	end
end

function fell(s)
	s.off=1
	s.oa=0
	s.sh=0
	if s.k=="t" then
		sfx(5,3)
		shk=3
	elseif s.k=="l" then
		sfx(9,3)
		shk=1
	else
		sfx(10,3)
		shk=1
	end
	for i=1,3 do
		add(picks,{x=s.x+rnd(12)-6,y=s.y+rnd(8)-2,t=rnd(1),k=s.mat})
	end
	for i=1,8 do
		add(parts,{x=s.x+rnd(10)-5,y=s.y,vx=rnd(1.6)-0.8,vy=-rnd(1.8),c=(s.k=="t" and 11 or s.k=="l" and 9 or 4),l=24})
	end
end

function won()
	mode=1
	sfx(8,3)
	shk=3
	for i=1,30 do
		add(parts,{x=lg.x+rnd(40)-20,y=lg.y+rnd(24)-12,vx=rnd(1.4)-0.7,vy=-rnd(1.8),c=10,l=54})
	end
end

function _update60()
	clock+=1
	shk*=0.87
	updparts()
	if rnd(1)<0.05 then
		add(parts,{x=camx+rnd(128),y=camy-2,vx=rnd(0.6)-0.3,vy=0.4,c=9,l=200,g=0})
	end
	for s in all(sources) do
		if s.off>0 then s.oa+=1 end
		s.sh*=0.75
	end
	if mode==1 then
		if btnp(5) then _init() end
		return
	end
	for s in all(picks) do s.t+=0.09 end
	local tgt,bd=nil,nil
	for s in all(sources) do
		if s.off==0 then
			local d=(s.x-p.x)*(s.x-p.x)+(s.y-p.y)*(s.y-p.y)
			if d<784 and (bd==nil or d<bd) then
				bd=d
				tgt=s
			end
		end
	end
	ntgt=tgt
	local dx,dy=0,0
	if btn(0) then dx-=1 end
	if btn(1) then dx+=1 end
	if btn(2) then dy-=1 end
	if btn(3) then dy+=1 end
	local act=btn(5) and tgt~=nil
	if act then
		if ctar~=tgt then
			chp=0
			ctar=tgt
		end
		chp+=1
		tgt.sh=sin(chp*0.9)*1.6
		if chp%12==0 then
			sfx(4,3)
			add(parts,{x=tgt.x+rnd(8)-4,y=tgt.y,vx=rnd(2)-1,vy=-rnd(1.6),c=(tgt.k=="t" and 9 or tgt.k=="l" and 9 or 4),l=18})
		end
		if chp>=tgt.hp then
			fell(tgt)
			chp=0
			ctar=nil
		end
	else
		chp=max(0,chp-4)
		ctar=nil
	end
	if not act and (dx~=0 or dy~=0) then
		if dx~=0 then p.fl=dx<0 end
		local l=sqrt(dx*dx+dy*dy)
		local nx=p.x+dx/l*1.15
		local ny=p.y+dy/l*1.15
		if not solid(nx,p.y) then p.x=nx end
		if not solid(p.x,ny) then p.y=ny end
		p.mt+=1
	else
		p.mt=0
	end
	for i=#picks,1,-1 do
		local s=picks[i]
		if carry[s.k]<cap and (s.x-p.x)*(s.x-p.x)+(s.y-p.y)*(s.y-p.y)<170 then
			del(picks,s)
			carry[s.k]+=1
			sfx(6,3)
			for k=1,5 do
				add(parts,{x=s.x,y=s.y,vx=rnd(2)-1,vy=-rnd(2),c=(s.k=="s" and 9 or s.k=="l" and 10 or 4),l=16})
			end
		end
	end
	if (p.x-lg.x)*(p.x-lg.x)+(p.y-lg.y)*(p.y-lg.y)<900 then
		if clock%9==0 then
			local k=nil
			for i=1,3 do
				local j=kinds[i]
				if k==nil and carry[j]>0 and got[j]<need[j] then k=j end
			end
			if k then
				carry[k]-=1
				got[k]+=1
				sfx(7,3)
				add(parts,{x=p.x,y=p.y-4,vx=(lg.x-p.x)*0.08,vy=-1.4,c=(k=="s" and 9 or k=="m" and 4 or 11),l=22})
				if got.s>=need.s and got.m>=need.m and got.l>=need.l then won() end
			end
			for i=1,3 do
				local j=kinds[i]
				if carry[j]>0 and got[j]>=need[j] then carry[j]=0 end
			end
		end
	end
	camx=mid(0,p.x-64,128)
	camy=mid(0,p.y-64,128)
end

function drawtree(s)
	local cx,y=s.x+s.sh,s.y
	if s.off>0 then
		ovalfill(s.x-4,y+4,s.x+4,y+7,2)
		rectfill(s.x-2,y+1,s.x+2,y+5,4)
		rectfill(s.x-1,y+2,s.x+1,y+4,9)
		return
	end
	ovalfill(s.x-6,y+5,s.x+6,y+9,2)
	rectfill(s.x-1,y+1,s.x+1,y+8,4)
	circfill(cx,y-3,7,2)
	circfill(cx,y-4,6,11)
	pset(cx-3,y-1,3)
	pset(cx+2,y-6,3)
	circfill(cx-2,y-6,2,7)
	pset(cx+3,y-2,7)
end

function drawleaf(s)
	local x,y=s.x,s.y
	if s.off>0 then
		if s.oa<26 then
			for i=0,3 do pset(x-5+i*3,y+2+(i%2)*2,9) end
		end
		return
	end
	ovalfill(x-7,y+1,x+7,y+6,2)
	circfill(x-3,y,3,9)
	circfill(x+3,y+1,3,10)
	circfill(x,y-2,3,9)
	pset(x-4,y-1,10)
	pset(x+4,y-1,9)
end

function drawmud(s)
	local x,y=s.x,s.y
	if s.off>0 then
		ovalfill(x-7,y,x+7,y+5,2)
		return
	end
	ovalfill(x-7,y-3,x+7,y+5,4)
	ovalfill(x-4,y-2,x+4,y+3,2)
	pset(x-2,y+1,9)
	pset(x+3,y,9)
	pset(x+1,y+3,9)
end

function drawsrc(s)
	if s.k=="t" then
		drawtree(s)
	elseif s.k=="l" then
		drawleaf(s)
	else
		drawmud(s)
	end
end

function drawpick(s)
	local x,y=s.x,s.y+sin(s.t)*1.4
	if s.k=="s" then
		line(x-3,y+1,x+2,y-2,9)
		line(x-3,y-1,x+3,y+1,4)
	elseif s.k=="l" then
		circfill(x,y-1,2,9)
		circfill(x+2,y,2,10)
		pset(x,y-3,10)
	else
		circfill(x,y,2,4)
		circfill(x,y-1,1,2)
	end
	pset(x,y+3,2)
end

function drawplayer()
	local x,y=p.x,p.y
	local f=0
	local bob=0
	if chp>0 then
		f=3
		x+=sin(chp*0.8)
	elseif p.mt>0 then
		f=1+flr(p.mt/5)%2
		bob=flr(sin(p.mt*0.45))
	end
	ovalfill(x-6,y+5,x+6,y+7,2)
	sspr(8+f*16,0,16,16,x-8,y-12+bob,16,16,p.fl)
end

function drawsite()
	if got.s>=need.s and got.m>=need.m and got.l>=need.l then return end
	for i=0,7 do
		local a=i*0.785
		local px,py=lg.x+cos(a)*22,lg.y+sin(a)*14
		line(px-4,py+1,px+4,py-1,4)
		line(px-4,py,px+4,py-2,9)
	end
end

function drawlodge()
	local x,y=lg.x,lg.y
	local qs=got.s/need.s
	local qm=got.m/need.m
	local ql=got.l/need.l
	if qm>0 then
		local mw=8+flr(qm*9)
		ovalfill(x-mw,y+2,x+mw,y+10,4)
		ovalfill(x-mw+3,y+4,x+mw-3,y+8,2)
		for i=0,5 do
			local a=i*1.047
			pset(x+cos(a)*(mw-2),y+6+sin(a)*2,9)
		end
	end
	if qs>0 then
		local h=3+flr(qs*13)
		local w=5+flr(qs*10)
		ovalfill(x-w,y+9-h,x+w,y+9,4)
		for i=0,7 do
			local u=i/8
			local yy=y+9-h*u
			local ww=w*sqrt(1-u*u)*1.05
			if ww>1 then line(x-ww,yy,x+ww,yy,i%2==0 and 9 or 4) end
		end
		oval(x-w,y+9-h,x+w,y+9,2)
		if qs>0.5 then ovalfill(x-3,y+3,x+3,y+9,0) end
	end
	if ql>0 then
		local h=3+flr(qs*13)
		local w=5+flr(qs*10)
		for i=1,flr(ql*4) do
			local a=3.5+i*0.5
			local lx=x+cos(a)*w*0.8
			local ly=y+9-h*0.72+sin(a)*h*0.4
			circfill(lx,ly,2,11)
			pset(lx,ly-2,7)
		end
	end
end

function maticon(k,x,y)
	if k=="s" then
		line(x,y+4,x+6,y,9)
		line(x,y,x+6,y+4,4)
	elseif k=="l" then
		circfill(x+3,y+2,3,9)
		circfill(x+4,y+1,2,10)
		pset(x+2,y+1,7)
	else
		ovalfill(x,y+1,x+6,y+5,4)
		ovalfill(x+2,y+2,x+4,y+4,2)
	end
end

function hud()
	rectfill(0,0,127,10,0)
	rectfill(0,113,127,127,0)
	local pc={s=10,m=9,l=11}
	for i=1,3 do
		local k=kinds[i]
		local x=3+(i-1)*42
		maticon(k,x,3)
		for q=1,need[k] do
			local px=x+10+(q-1)*3
			if q<=got[k] then
				rectfill(px,4,px+1,8,pc[k])
			else
				rect(px,4,px+1,8,5)
			end
		end
		maticon(k,x,115)
		for q=1,cap do
			local px=x+10+(q-1)*3
			if q<=carry[k] then
				rectfill(px,116,px+1,120,pc[k])
			else
				rect(px,116,px+1,120,5)
			end
		end
	end
end

function introon()
	return clock<420 and got.s+got.m+got.l+carry.s+carry.m+carry.l==0
end

function drawintro()
	rectfill(0,86,127,111,0)
	local l={"arrows: walk","x at tree: sticks","x at leaves: leaves","x at mud: mud"}
	for i=1,4 do
		local s=l[i]
		print(s,(128-#s*4)/2,88+(i-1)*6,7)
	end
end

function hints()
	local s=nil
	if ntgt then
		if ntgt.k=="t" then
			s="hold x to chew sticks"
		elseif ntgt.k=="l" then
			s="hold x to gather leaves"
		else
			s="hold x to scoop mud"
		end
	elseif carry.s+carry.m+carry.l>0 then
		s="bring it to the twig ring"
	end
	if s then
		rectfill(0,96,127,105,0)
		print(s,(128-#s*4)/2,98,7)
	end
end

function windraw()
	rectfill(8,56,119,96,0)
	rect(8,56,119,96,9)
	local s="your lodge is done!"
	print(s,(128-#s*4)/2,63,10)
	local s2="press X to build again"
	print(s2,(128-#s2*4)/2,77,7)
end

function _draw()
	cls(3)
	local ox,oy=camx,camy
	if shk>0.2 then
		ox+=rnd(shk)-shk*0.5
		oy+=rnd(shk)-shk*0.5
	end
	camera(flr(ox),flr(oy))
	map(0,0,0,0,32,32)
	drawsite()
	drawlodge()
	for s in all(sources) do
		if s.y<=p.y then drawsrc(s) end
	end
	for s in all(picks) do drawpick(s) end
	drawplayer()
	for s in all(sources) do
		if s.y>p.y then drawsrc(s) end
	end
	for q in all(parts) do
		local c=q.c
		if q.l<14 then c=7 end
		pset(q.x,q.y,c)
	end
	if ctar and chp>0 then
		local w=14
		rectfill(ctar.x-w/2-1,ctar.y-13,ctar.x+w/2+1,ctar.y-9,0)
		rectfill(ctar.x-w/2,ctar.y-12,ctar.x-w/2+w*chp/ctar.hp,ctar.y-10,10)
	end
	camera()
	hud()
	if mode==1 then
		windraw()
	elseif introon() then
		drawintro()
	else
		hints()
	end
end

